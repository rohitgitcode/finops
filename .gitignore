# ==========================================
# Root .gitignore for LedgerMind / FinOps AI
# ==========================================

# Secrets & Environment Variables (NEVER commit these!)
**/.env
**/.env.*
!**/.env.example
**/*.local*
**/*.local.js

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/venv/
**/.venv/
**/env/
**/.pytest_cache/
**/.coverage

# Node / Frontend
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.vite/

# Temporary uploads & invoice PDFs
**/*.pdf
**/temp/
**/tmp/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

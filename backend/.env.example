# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Connection String (Neon)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require&channel_binding=require

# Inbound Webhook Authentication Secret
WEBHOOK_SECRET=your_secure_webhook_token_here

# Resend Email API Credentials
RESEND_API_KEY=re_your_resend_api_key_here
MANAGER_ALERT_EMAIL=manager@yourdomain.com

# Backend Public Base URL (Used for One-Click Decision Buttons in Email)
# In production, set this to your deployed backend domain (e.g., https://api.yourdomain.com)
API_BASE_URL=http://127.0.0.1:8000
